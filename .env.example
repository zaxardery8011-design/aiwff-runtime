# Runtime environment variables
# Copy this file to .env — npm install is optional (zero external dependencies)

PORT=3100
# WebUI 寫入授權（選填）。
# 不設：每次啟動自動產生一次性 token，終端機會印出「登入 WebUI：http://127.0.0.1:<PORT>/?token=...」，
#       用瀏覽器點那條連結就會登入（token 存在 HttpOnly cookie aiwff_runtime_token_<PORT>）；重啟後要重點新連結。
# 設了：固定用這個值，方便腳本 / curl 帶 x-aiwff-runtime-token header 呼叫寫入 API。
AIWFF_RUNTIME_TOKEN=

# Telegram Bot（選填，不填就只有 WebUI）
TG_BOT_TOKEN=
# Required when TG_BOT_TOKEN is set.
ADMIN_TG_CHAT_ID=

# Worker mode: public default is mock. Enable real Claude explicitly.
CLAUDE_CMD=claude
MOCK_WORKER=1
ENABLE_REAL_CLAUDE_WORKER=
# Adds --dangerously-skip-permissions to claude --print.
CLAUDE_BYPASS_APPROVALS=

# Antigravity CLI (agy) worker（選填）。設 AIWFF_WORKER_PROVIDER=agy 啟用，並把上面的 MOCK_WORKER 清空（MOCK_WORKER 優先）。
AIWFF_WORKER_PROVIDER=
# agy 執行檔。不在 PATH 時要填完整路徑，例如 Windows 預設裝在 %LOCALAPPDATA%\agy\bin\agy.exe。
AGY_CMD=agy
# 選填。有值時 spawn 加 --model <值>；沒填就用 agy 自己的預設模型。
AGY_MODEL=
# 設 1 才加 --dangerously-skip-permissions：worker 可以不經確認直接讀寫檔案、執行指令。只在你信任任務來源的機器上開。
AGY_SKIP_PERMISSIONS=
