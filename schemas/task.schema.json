{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/aiwff-runtime/task.schema.json",
  "title": "AIWFF Runtime Task",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "instruction", "status", "created_at", "updated_at"],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "instruction": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["pending", "running", "done", "failed", "blocked"]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "artifact_path": {
      "type": "string"
    },
    "error": {
      "type": "string"
    },
    "error_origin": {
      "type": "string",
      "enum": ["runtime", "worker", "provider"]
    },
    "timeout_sec": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600
    },
    "blocked_reason": {
      "type": "string"
    },
    "timeout_phase": {
      "type": "string",
      "enum": ["spawn", "prompt_sent", "streaming", "detached_no_stdio", "unknown"]
    },
    "timeout_phase_stuck_sec": {
      "type": "integer",
      "minimum": 0
    },
    "timeout_phase_timeline": {
      "type": "string",
      "minLength": 1
    },
    "timeout_kind": {
      "type": "string",
      "enum": ["stalled", "slow", "unknown"]
    },
    "timeout_idle_sec": {
      "type": "integer",
      "minimum": 0
    },
    "retry_count": {
      "type": "integer",
      "minimum": 0
    },
    "last_error": {
      "type": "string"
    },
    "resume_count": {
      "type": "integer",
      "minimum": 0
    },
    "resume_checkpoint_steps": {
      "type": "integer",
      "minimum": 0
    },
    "resume_no_progress_count": {
      "type": "integer",
      "minimum": 0
    },
    "env_cause": {
      "type": "string",
      "enum": ["auth", "missing_tool", "permission", "network"]
    },
    "env_hint": {
      "type": "string",
      "minLength": 1
    },
    "conversation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "bot_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    }
  }
}
